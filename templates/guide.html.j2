{% from "_steps.j2" import steps %}
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'">
<title>スキンケアルーティン 手引き</title>
<style>
@page { size: A4; margin: 10mm 11mm; }
:root { --text: #1f2328; --sub: #59636e; --line: #d8dee4; --soft: #f4f6f8; --head: #2b7a3d;
  --rs: #c8501a; --acid: #1d6fc0; --retinol: #6a46d6; --rest: #2f8f47; --warn: #b54708; }
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: "Hiragino Sans", "Noto Sans CJK JP", "Noto Sans JP", sans-serif; color: var(--text);
  background: #fff; font-size: 8.8pt; line-height: 1.45; max-width: 190mm; margin: 0 auto; padding: 4mm 0; }
h1 { font-size: 17pt; border-bottom: 2.5pt solid var(--head); padding-bottom: 2mm; margin-bottom: 3mm; }
h1 small { font-size: 9pt; color: var(--sub); font-weight: 400; margin-left: 3mm; }
h2 { font-size: 11pt; border-left: 3.5pt solid var(--head); padding-left: 2.5mm; margin: 3.5mm 0 1.6mm; break-after: avoid; }
.rule { background: #1f2328; color: #fff; text-align: center; font-weight: 700; border-radius: 2mm; padding: 2mm; }
.box { background: var(--soft); border: 1px solid var(--line); border-radius: 2mm; padding: 2.5mm 3mm; break-inside: avoid; }
.flow { display: flex; flex-wrap: wrap; gap: 1.5mm 2mm; align-items: center; margin-bottom: 1.5mm; }
.flow span { border: 1px solid var(--head); border-radius: 99px; padding: 0.4mm 3mm; background: #fff; font-weight: 600; }
.flow i { color: var(--sub); font-style: normal; }
.note, .why { color: var(--sub); font-size: 8.2pt; }
table { width: 100%; border-collapse: collapse; margin-top: 1.5mm; break-inside: avoid; }
th { background: var(--head); color: #fff; text-align: left; font-weight: 600; padding: 1.2mm 2mm; }
td { border-bottom: 1px solid var(--line); padding: 1.2mm 2mm; vertical-align: top; }
.nights { display: grid; gap: 2mm; }
.night { border: 1px solid var(--line); border-radius: 2mm; break-inside: avoid; overflow: hidden; }
.night .hd { background: var(--c); color: #fff; font-weight: 700; padding: 1.2mm 3mm; }
.night .bd { padding: 1.8mm 3mm; }
.steps { list-style: none; counter-reset: s; display: flex; flex-wrap: wrap; gap: 0.6mm 4mm; }
.steps li { counter-increment: s; }
.steps li::before { content: counter(s); display: inline-grid; place-items: center; width: 4.2mm; height: 4.2mm;
  border-radius: 50%; background: var(--text); color: #fff; font-size: 7pt; font-weight: 700; margin-right: 1.2mm; vertical-align: 0.2mm; }
.steps .t { font-weight: 600; }
.steps .n { color: var(--sub); font-size: 8pt; margin-left: 1mm; }
.steps .n::before { content: "("; } .steps .n::after { content: ")"; }
.from { color: var(--warn); border: 1px solid currentColor; border-radius: 99px; padding: 0 1.5mm; font-size: 7.5pt; margin-left: 1mm; }
li.started .from { display: none; }
.why { margin-top: 1mm; }
.two { display: grid; grid-template-columns: 1fr 1fr; gap: 4mm; }
ul.plain { padding-left: 4.5mm; } ul.plain li { margin: 0.6mm 0; }
.warnbox { background: #fff4ec; border: 1px solid #f3c7a8; border-radius: 2mm; padding: 2.5mm 3mm; break-inside: avoid; }
.warnbox li::marker { content: "⚠ "; color: var(--warn); }
.page-break { break-before: page; }
.c-rs { --c: var(--rs); } .c-acid { --c: var(--acid); } .c-retinol { --c: var(--retinol); } .c-rest { --c: var(--rest); }
@media screen { body { padding: 8mm 4mm; } }
</style>
</head>
<body>
<h1>{{ d.title }}<small>{{ d.since }}〜 / 更新 {{ d.updated }} / これを見ながらそのままやればOK</small></h1>
<p class="rule">鉄則: {{ d.rule }}</p>

<h2>重ねる順番の考え方(迷ったらこれに戻る)</h2>
<div class="box">
  <div class="flow">
    {% for o in d.layering.order %}<span>{{ o }}</span>{% if not loop.last %}<i>→</i>{% endif %}{% endfor %}
  </div>
  <p class="note">{{ d.layering.note }}</p>
  <table>
    <tr><th>フタは2種類</th><th>正体</th><th>いつ使う?</th></tr>
    {% for l in d.lids %}<tr><td><b>{{ l.kind }}</b><br>{{ l["items"] }}</td><td>{{ l.feel }}</td><td>{{ l.when }}</td></tr>{% endfor %}
  </table>
</div>

<h2>夜のルーティン(顔)</h2>
<div class="nights">
  {% for key, n in d.nights.items() %}
  {% set days = d.week_list | selectattr("night.key", "equalto", key) | map(attribute="ja") | list %}
  <div class="night c-{{ n.color }}">
    <div class="hd">{{ days | join("・") }} = {{ n.name }}</div>
    <div class="bd">{{ steps(n.steps) }}<p class="why">{{ n.why }}</p></div>
  </div>
  {% endfor %}
</div>

<h2>朝(毎日同じ・考えない)</h2>
<div class="box">{{ steps(d.morning.steps) }}<p class="note">{{ d.morning.note }}</p></div>

<h2>体・背中</h2>
<div class="two">
  <div class="box"><b>{{ d.body.daily.title }}</b>{{ steps(d.body.daily.steps) }}<p class="note">{{ d.body.daily.note }} {{ d.body.spot }}</p></div>
  <div class="box"><b>{{ d.body.mist.title }}</b>{{ steps(d.body.mist.steps) }}<p class="note">{{ d.body.mist.note }}</p></div>
</div>


<h2>これから足すもの(1つ足したら1週間は様子を見る)</h2>
<table>
  <tr><th style="width:22%">いつから</th><th>やること</th><th style="width:36%">見ているポイント</th></tr>
  {% for p in d.plan %}<tr><td><b>{{ p.label }}</b></td><td>{{ p.what }}</td><td>{{ p.watch }}</td></tr>{% endfor %}
</table>
<p class="note">1つずつ足す理由: 肌に合わないものがあったとき「犯人」がすぐ特定できるから。</p>

<h2>頓服ケア(吹き出物・しこりができてしまったとき)</h2>
<table>
  <tr><th style="width:15%">状態</th><th style="width:25%">見分け方</th><th>対処</th></tr>
  {% for s in d.spot_care %}<tr><td><b>{{ s.state }}</b></td><td>{{ s.sign }}</td><td>{{ s.action }}</td></tr>{% endfor %}
</table>
<div class="warnbox" style="margin-top:2mm"><ul class="plain">{% for n in d.spot_care_notes %}<li>{{ n }}</li>{% endfor %}</ul></div>

<div class="two">
  <div>
    <h2>在庫マップ</h2>
    <table>
      <tr><th style="width:28%">役割</th><th>アイテム</th></tr>
      {% for i in d.inventory %}<tr><td>{{ i.role }}</td><td>{{ i["items"] }}</td></tr>{% endfor %}
    </table>
    <h2>ゴールの目安</h2>
    <ul class="plain">{% for g in d.goals %}<li><b>{{ g.area }}</b>: {{ g.text }}</li>{% endfor %}</ul>
  </div>
  <div>
    <h2>絶対に守ること</h2>
    <div class="warnbox"><ul class="plain">{% for n in d.never %}<li>{{ n }}</li>{% endfor %}</ul></div>
    <h2>肌トラブルが出たら(リセット手順)</h2>
    <ul class="plain">{% for r in d.reset %}<li>{{ r }}</li>{% endfor %}</ul>
  </div>
</div>
<script>
// 始める日が来た手順は「◯/◯から」の印を消す
const iso = new Date(Date.now() + 9 * 3600e3).toISOString().slice(0, 10);
document.querySelectorAll("li[data-from]").forEach(el => el.classList.toggle("started", iso >= el.dataset.from));
</script>
</body>
</html>
